<Page
  x:Class="NanaBox.VirtualMachineSettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  IsTextScaleFactorEnabled="False"
  mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Padding="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button
        x:Uid="/VirtualMachineSettingsPage/ReloadButton"
        Margin="0,0,8,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        AutomationProperties.Name="[Reload Configuration]"
        IsEnabled="False">
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/ReloadButtonTextBlock"
          Text="[Reload Configuration]"
          TextWrapping="Wrap" />
      </Button>
      <Button
        x:Name="OpenButton"
        x:Uid="/VirtualMachineSettingsPage/OpenButton"
        Grid.Column="1"
        Margin="0,0,8,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        AutomationProperties.Name="[Open Virtual Machine Configuration File]"
        Click="OpenButtonClick">
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/OpenButtonTextBlock"
          Text="[Open Virtual Machine Configuration File]"
          TextWrapping="Wrap" />
      </Button>
      <Button
        x:Uid="/VirtualMachineSettingsPage/ReferenceButton"
        Grid.Column="2"
        Margin="0,0,8,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        AutomationProperties.Name="[Configuration File Reference]"
        Click="ReferenceButtonClick">
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/ReferenceButtonTextBlock"
          Text="[Configuration File Reference]"
          TextWrapping="Wrap" />
      </Button>
      <Button
        x:Name="ApplyButton"
        x:Uid="/VirtualMachineSettingsPage/ApplyButton"
        Grid.Column="3"
        Margin="0,0,8,0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        AutomationProperties.Name="[Apply Changes]"
        Click="ApplyButtonClick">
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/ApplyButtonTextBlock"
          Text="[Apply Changes]"
          TextWrapping="Wrap" />
      </Button>
      <Button
        x:Name="CreateButton"
        x:Uid="/VirtualMachineSettingsPage/CreateButton"
        Grid.Column="4"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        AutomationProperties.Name="[Create Virtual Machine]"
        Click="CreateButtonClick">
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/CreateButtonTextBlock"
          Text="[Create Virtual Machine]"
          TextWrapping="Wrap" />
      </Button>
    </Grid>
  </Grid>
</Page>
