<Page
  x:Class="NanaBox.VirtualMachineSettingsPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="using:NanaBox"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  IsTextScaleFactorEnabled="False"
  mc:Ignorable="d">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Padding="16,8">
      <Grid.Background>
        <SolidColorBrush Opacity="0.2" Color="{ThemeResource SystemChromeHighColor}" />
      </Grid.Background>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button
        x:Name="ReloadButton"
        x:Uid="/VirtualMachineSettingsPage/ReloadButton"
        Grid.Column="0"
        Margin="0,0,8,0"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Center"
        AutomationProperties.Name="[Reload Configuration]"
        Click="ReloadButtonClick">
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/ReloadButtonTextBlock"
          Text="[Reload Configuration]"
          TextWrapping="Wrap" />
      </Button>
      <Button
        x:Name="OpenButton"
        x:Uid="/VirtualMachineSettingsPage/OpenButton"
        Grid.Column="1"
        Margin="0,0,8,0"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Center"
        AutomationProperties.Name="[Open Virtual Machine Configuration File]"
        Click="OpenButtonClick">
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/OpenButtonTextBlock"
          Text="[Open Virtual Machine Configuration File]"
          TextWrapping="Wrap" />
      </Button>
      <Button
        x:Name="ReferenceButton"
        x:Uid="/VirtualMachineSettingsPage/ReferenceButton"
        Grid.Column="2"
        Margin="0,0,8,0"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Center"
        AutomationProperties.Name="[Configuration File Reference Documentation]"
        Click="ReferenceButtonClick">
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/ReferenceButtonTextBlock"
          Text="[Configuration File Reference Documentation]"
          TextWrapping="Wrap" />
      </Button>
      <Button
        x:Name="ApplyButton"
        x:Uid="/VirtualMachineSettingsPage/ApplyButton"
        Grid.Column="3"
        Margin="0,0,0,0"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Center"
        AutomationProperties.Name="[Apply Changes]"
        Click="ApplyButtonClick">
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/ApplyButtonTextBlock"
          Text="[Apply Changes]"
          TextWrapping="Wrap" />
      </Button>
    </Grid>
    <ScrollViewer
      Grid.Row="1"
      HorizontalScrollBarVisibility="Disabled"
      VerticalScrollBarVisibility="Auto">
      <StackPanel Padding="16,4,16,16" Spacing="4">
        <TextBlock
          x:Name="RuntimeNotice"
          x:Uid="/VirtualMachineSettingsPage/RuntimeNoticeText"
          Text="[Only settings that can be changed at runtime are shown.]"
          TextWrapping="Wrap" />
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/GeneralTitle"
          Margin="0,8,0,0"
          FontSize="16"
          FontWeight="SemiBold"
          Text="[General]" />
        <StackPanel x:Name="NameRow" Spacing="4">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
              x:Uid="/VirtualMachineSettingsPage/NameLabel"
              Margin="0,0,12,0"
              VerticalAlignment="Center"
              Text="[Name]"
              TextWrapping="Wrap" />
            <TextBox
              x:Name="NameTextBox"
              x:Uid="/VirtualMachineSettingsPage/NameTextBox"
              Grid.Column="1"
              HorizontalAlignment="Stretch"
              AutomationProperties.HelpText="[The unique name of virtual machine.]"
              AutomationProperties.Name="[Name]"
              ToolTipService.ToolTip="[The unique name of virtual machine.]" />
          </Grid>
        </StackPanel>
        <StackPanel x:Name="ProcessorCountRow" Spacing="4">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
              x:Uid="/VirtualMachineSettingsPage/ProcessorCountLabel"
              Margin="0,0,12,0"
              VerticalAlignment="Center"
              Text="[ProcessorCount]"
              TextWrapping="Wrap" />
            <TextBox
              x:Name="ProcessorCountTextBox"
              x:Uid="/VirtualMachineSettingsPage/ProcessorCountTextBox"
              Grid.Column="1"
              Width="120"
              HorizontalAlignment="Left"
              AutomationProperties.HelpText="[The processor count of virtual machine, in cores.]"
              AutomationProperties.Name="[ProcessorCount]"
              ToolTipService.ToolTip="[The processor count of virtual machine, in cores.]" />
          </Grid>
        </StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock
            x:Uid="/VirtualMachineSettingsPage/MemorySizeLabel"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Text="[MemorySize (MB)]"
            TextWrapping="Wrap" />
          <TextBox
            x:Name="MemorySizeTextBox"
            x:Uid="/VirtualMachineSettingsPage/MemorySizeTextBox"
            Grid.Column="1"
            Width="120"
            HorizontalAlignment="Left"
            AutomationProperties.HelpText="[The memory size of virtual machine, in MB.]"
            AutomationProperties.Name="[MemorySize (MB)]"
            ToolTipService.ToolTip="[The memory size of virtual machine, in MB.]" />
        </Grid>
        <StackPanel x:Name="SecureBootRow" Spacing="4">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
              x:Uid="/VirtualMachineSettingsPage/SecureBootLabel"
              Margin="0,0,12,0"
              VerticalAlignment="Center"
              Text="[SecureBoot]"
              TextWrapping="Wrap" />
            <CheckBox
              x:Name="SecureBootCheckBox"
              x:Uid="/VirtualMachineSettingsPage/SecureBootCheckBox"
              Grid.Column="1"
              HorizontalAlignment="Left"
              AutomationProperties.HelpText="[(Optional) The Secure Boot setting of virtual machine.]"
              AutomationProperties.Name="[SecureBoot]"
              ToolTipService.ToolTip="[(Optional) The Secure Boot setting of virtual machine.]" />
          </Grid>
        </StackPanel>
        <StackPanel x:Name="TpmRow" Spacing="4">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
              x:Uid="/VirtualMachineSettingsPage/TpmLabel"
              Margin="0,0,12,0"
              VerticalAlignment="Center"
              Text="[Tpm]"
              TextWrapping="Wrap" />
            <CheckBox
              x:Name="TpmCheckBox"
              x:Uid="/VirtualMachineSettingsPage/TpmCheckBox"
              Grid.Column="1"
              HorizontalAlignment="Left"
              AutomationProperties.HelpText="[(Optional) The Trusted Platform Module (TPM) setting of virtual machine.]"
              AutomationProperties.Name="[Tpm]"
              ToolTipService.ToolTip="[(Optional) The Trusted Platform Module (TPM) setting of virtual machine.]" />
          </Grid>
          <TextBlock
            x:Uid="/VirtualMachineSettingsPage/TpmNote"
            FontSize="12"
            Opacity="0.75"
            Text="[Note: You need Windows 11 Version 24H2 or later Host OS.]"
            TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel x:Name="VirtualizationExtensionsRow" Spacing="4">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
              x:Uid="/VirtualMachineSettingsPage/VirtualizationExtensionsLabel"
              Margin="0,0,12,0"
              VerticalAlignment="Center"
              Text="[ExposeVirtualizationExtensions]"
              TextWrapping="Wrap" />
            <CheckBox
              x:Name="VirtualizationExtensionsCheckBox"
              x:Uid="/VirtualMachineSettingsPage/VirtualizationExtensionsCheckBox"
              Grid.Column="1"
              HorizontalAlignment="Left"
              AutomationProperties.HelpText="[(Optional) Expose the virtualization extensions to the virtual machine if set it true.]"
              AutomationProperties.Name="[ExposeVirtualizationExtensions]"
              ToolTipService.ToolTip="[(Optional) Expose the virtualization extensions to the virtual machine if set it true.]" />
          </Grid>
        </StackPanel>
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/ComPortsTitle"
          Margin="0,8,0,0"
          FontSize="16"
          FontWeight="SemiBold"
          Text="[ComPorts]" />
        <StackPanel x:Name="UefiConsoleRow" Spacing="4">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
              x:Uid="/VirtualMachineSettingsPage/UefiConsoleLabel"
              Margin="0,0,12,0"
              VerticalAlignment="Center"
              Text="[UefiConsole]"
              TextWrapping="Wrap" />
            <ComboBox
              x:Name="UefiConsoleComboBox"
              x:Uid="/VirtualMachineSettingsPage/UefiConsoleComboBox"
              Grid.Column="1"
              MinWidth="120"
              HorizontalAlignment="Left"
              AutomationProperties.HelpText="[The UEFI serial console setting of virtual machine.]"
              AutomationProperties.Name="[UefiConsole]"
              ToolTipService.ToolTip="[The UEFI serial console setting of virtual machine.]">
              <ComboBoxItem x:Uid="/VirtualMachineSettingsPage/ChoiceDisabledItem" Content="Disabled" />
              <ComboBoxItem x:Uid="/VirtualMachineSettingsPage/ChoiceDefaultItem" Content="Default" />
              <ComboBoxItem x:Uid="/VirtualMachineSettingsPage/ChoiceComPort1Item" Content="ComPort1" />
              <ComboBoxItem x:Uid="/VirtualMachineSettingsPage/ChoiceComPort2Item" Content="ComPort2" />
            </ComboBox>
          </Grid>
        </StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock
            x:Uid="/VirtualMachineSettingsPage/ComPort1Label"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Text="[ComPort1]"
            TextWrapping="Wrap" />
          <TextBox
            x:Name="ComPort1TextBox"
            x:Uid="/VirtualMachineSettingsPage/ComPort1TextBox"
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            AutomationProperties.HelpText="[(Optional) The named pipe path of guest COM1 of virtual machine.]"
            AutomationProperties.Name="[ComPort1]"
            ToolTipService.ToolTip="[(Optional) The named pipe path of guest COM1 of virtual machine.]" />
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock
            x:Uid="/VirtualMachineSettingsPage/ComPort2Label"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Text="[ComPort2]"
            TextWrapping="Wrap" />
          <TextBox
            x:Name="ComPort2TextBox"
            x:Uid="/VirtualMachineSettingsPage/ComPort2TextBox"
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            AutomationProperties.HelpText="[(Optional) The named pipe path of guest COM2 of virtual machine.]"
            AutomationProperties.Name="[ComPort2]"
            ToolTipService.ToolTip="[(Optional) The named pipe path of guest COM2 of virtual machine.]" />
        </Grid>
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/StateNote"
          FontSize="12"
          Opacity="0.75"
          Text="[Note: The relative path is supported.]"
          TextWrapping="Wrap" />
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/GpuTitle"
          Margin="0,8,0,0"
          FontSize="16"
          FontWeight="SemiBold"
          Text="[Gpu]" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock
            x:Uid="/VirtualMachineSettingsPage/AssignmentModeLabel"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Text="[AssignmentMode]"
            TextWrapping="Wrap" />
          <ComboBox
            x:Name="AssignmentModeComboBox"
            x:Uid="/VirtualMachineSettingsPage/AssignmentModeComboBox"
            Grid.Column="1"
            MinWidth="120"
            HorizontalAlignment="Left"
            AutomationProperties.HelpText="[The GPU assignment mode setting of virtual machine.]"
            AutomationProperties.Name="[AssignmentMode]"
            ToolTipService.ToolTip="[The GPU assignment mode setting of virtual machine.]">
            <ComboBoxItem x:Uid="/VirtualMachineSettingsPage/ChoiceDisabledItem2" Content="Disabled" />
            <ComboBoxItem x:Uid="/VirtualMachineSettingsPage/ChoiceDefaultItem2" Content="Default" />
            <ComboBoxItem x:Uid="/VirtualMachineSettingsPage/ChoiceListItem" Content="List" />
            <ComboBoxItem x:Uid="/VirtualMachineSettingsPage/ChoiceMirrorItem" Content="Mirror" />
          </ComboBox>
        </Grid>
        <StackPanel x:Name="EnableHostDriverStoreRow" Spacing="4">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
              x:Uid="/VirtualMachineSettingsPage/EnableHostDriverStoreLabel"
              Margin="0,0,12,0"
              VerticalAlignment="Center"
              Text="[EnableHostDriverStore]"
              TextWrapping="Wrap" />
            <CheckBox
              x:Name="EnableHostDriverStoreCheckBox"
              x:Uid="/VirtualMachineSettingsPage/EnableHostDriverStoreCheckBox"
              Grid.Column="1"
              HorizontalAlignment="Left"
              AutomationProperties.HelpText="[(Optional) Set it true if you want to enable readonly Plan 9 and Virtual SMB shares for several GPU-PV (paravirtualization) related folders from the Host OS.]"
              AutomationProperties.Name="[EnableHostDriverStore]"
              ToolTipService.ToolTip="[(Optional) Set it true if you want to enable readonly Plan 9 and Virtual SMB shares for several GPU-PV (paravirtualization) related folders from the Host OS.]" />
          </Grid>
          <TextBlock
            x:Uid="/VirtualMachineSettingsPage/ShareNote"
            FontSize="12"
            Opacity="0.75"
            Text="[Note: You cannot suspend the virtual machine properly if this option is enabled.]"
            TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/GpuDeviceTitle"
          Margin="0,8,0,0"
          FontSize="16"
          FontWeight="SemiBold"
          Text="[SelectedDevices]" />
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/GpuDeviceDescription"
          FontSize="12"
          Opacity="0.75"
          Text="[(Optional) The string or object array of selected GPUs used for virtual machine. Set as the object with &quot;DeviceInterface&quot; and &quot;PartitionId&quot; for the specific GPU instance if you want to use GPU-P (partitioning) mode, or set as the string which contains &quot;DeviceInterface&quot; for using GPU-PV (paravirtualization) mode.]"
          TextWrapping="Wrap" />
        <StackPanel x:Name="GpuDevicePanel" Spacing="4" />
        <Button
          x:Name="AddGpuDeviceButton"
          x:Uid="/VirtualMachineSettingsPage/AddGpuDeviceButton"
          Click="AddGpuDeviceButtonClick"
          Content="[Add]" />
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/NetworkAdapterTitle"
          Margin="0,8,0,0"
          FontSize="16"
          FontWeight="SemiBold"
          Text="[NetworkAdapters]" />
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/NetworkAdapterDescription"
          FontSize="12"
          Opacity="0.75"
          Text="[The network adapters setting object array of virtual machine.]"
          TextWrapping="Wrap" />
        <StackPanel x:Name="NetworkAdapterPanel" Spacing="4" />
        <Button
          x:Name="AddNetworkAdapterButton"
          x:Uid="/VirtualMachineSettingsPage/AddNetworkAdapterButton"
          Click="AddNetworkAdapterButtonClick"
          Content="[Add]" />
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/NetworkNote"
          FontSize="12"
          Opacity="0.75"
          Text="[Note: Default behavior is use the default switch.]"
          TextWrapping="Wrap" />
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/ScsiDeviceTitle"
          Margin="0,8,0,0"
          FontSize="16"
          FontWeight="SemiBold"
          Text="[ScsiDevices]" />
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/ScsiDeviceDescription"
          FontSize="12"
          Opacity="0.75"
          Text="[The SCSI devices setting object array of virtual machine.]"
          TextWrapping="Wrap" />
        <StackPanel x:Name="ScsiDevicePanel" Spacing="4" />
        <Button
          x:Name="AddScsiDeviceButton"
          x:Uid="/VirtualMachineSettingsPage/AddScsiDeviceButton"
          Click="AddScsiDeviceButtonClick"
          Content="[Add]" />
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/ScsiNote"
          FontSize="12"
          Opacity="0.75"
          Text="[When type is &quot;VirtualImage&quot;, you can use iso files, and you can make it empty or not set if you want to make a ejected virtual optical drive.]"
          TextWrapping="Wrap" />
        <StackPanel x:Name="StateFilesSection" Spacing="4">
          <TextBlock
            x:Uid="/VirtualMachineSettingsPage/StateFilesTitle"
            Margin="0,8,0,0"
            FontSize="16"
            FontWeight="SemiBold"
            Text="[State Files]" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
              x:Uid="/VirtualMachineSettingsPage/GuestStateFileLabel"
              Margin="0,0,12,0"
              VerticalAlignment="Center"
              Text="[GuestStateFile]"
              TextWrapping="Wrap" />
            <TextBox
              x:Name="GuestStateFileTextBox"
              x:Uid="/VirtualMachineSettingsPage/GuestStateFileTextBox"
              Grid.Column="1"
              HorizontalAlignment="Stretch"
              AutomationProperties.HelpText="[(Optional) The path of guest state file for virtual machine.]"
              AutomationProperties.Name="[GuestStateFile]"
              ToolTipService.ToolTip="[(Optional) The path of guest state file for virtual machine.]" />
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
              x:Uid="/VirtualMachineSettingsPage/RuntimeStateFileLabel"
              Margin="0,0,12,0"
              VerticalAlignment="Center"
              Text="[RuntimeStateFile]"
              TextWrapping="Wrap" />
            <TextBox
              x:Name="RuntimeStateFileTextBox"
              x:Uid="/VirtualMachineSettingsPage/RuntimeStateFileTextBox"
              Grid.Column="1"
              HorizontalAlignment="Stretch"
              AutomationProperties.HelpText="[(Optional) The path of runtime state file for virtual machine.]"
              AutomationProperties.Name="[RuntimeStateFile]"
              ToolTipService.ToolTip="[(Optional) The path of runtime state file for virtual machine.]" />
          </Grid>
          <TextBlock
            x:Uid="/VirtualMachineSettingsPage/StateNote2"
            FontSize="12"
            Opacity="0.75"
            Text="[Note: The relative path is supported.]"
            TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock
          x:Uid="/VirtualMachineSettingsPage/KeyboardTitle"
          Margin="0,8,0,0"
          FontSize="16"
          FontWeight="SemiBold"
          Text="[Keyboard]" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock
            x:Uid="/VirtualMachineSettingsPage/RedirectKeyCombinationsLabel"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Text="[RedirectKeyCombinations]"
            TextWrapping="Wrap" />
          <CheckBox
            x:Name="RedirectKeyCombinationsCheckBox"
            x:Uid="/VirtualMachineSettingsPage/RedirectKeyCombinationsCheckBox"
            Grid.Column="1"
            HorizontalAlignment="Left"
            AutomationProperties.HelpText="[(Optional) Apply key combinations at the virtual machine if set it true, or apply key combinations to the virtual machine only when the host is running in full-screen mode.]"
            AutomationProperties.Name="[RedirectKeyCombinations]"
            ToolTipService.ToolTip="[(Optional) Apply key combinations at the virtual machine if set it true, or apply key combinations to the virtual machine only when the host is running in full-screen mode.]" />
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock
            x:Uid="/VirtualMachineSettingsPage/FullScreenHotkeyLabel"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Text="[FullScreenHotkey]"
            TextWrapping="Wrap" />
          <TextBox
            x:Name="FullScreenHotkeyTextBox"
            x:Uid="/VirtualMachineSettingsPage/FullScreenHotkeyTextBox"
            Grid.Column="1"
            Width="120"
            HorizontalAlignment="Left"
            AutomationProperties.HelpText="[(Optional) Specifies the virtual-key code to add to CTRL+ALT to determine the hotkey replacement for switching to full-screen mode.]"
            AutomationProperties.Name="[FullScreenHotkey]"
            ToolTipService.ToolTip="[(Optional) Specifies the virtual-key code to add to CTRL+ALT to determine the hotkey replacement for switching to full-screen mode.]" />
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock
            x:Uid="/VirtualMachineSettingsPage/CtrlEscHotkeyLabel"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Text="[CtrlEscHotkey]"
            TextWrapping="Wrap" />
          <TextBox
            x:Name="CtrlEscHotkeyTextBox"
            x:Uid="/VirtualMachineSettingsPage/CtrlEscHotkeyTextBox"
            Grid.Column="1"
            Width="120"
            HorizontalAlignment="Left"
            AutomationProperties.HelpText="[(Optional) Specifies the virtual-key code to add to ALT to determine the hotkey replacement for CTRL+ESC.]"
            AutomationProperties.Name="[CtrlEscHotkey]"
            ToolTipService.ToolTip="[(Optional) Specifies the virtual-key code to add to ALT to determine the hotkey replacement for CTRL+ESC.]" />
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock
            x:Uid="/VirtualMachineSettingsPage/AltEscHotkeyLabel"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Text="[AltEscHotkey]"
            TextWrapping="Wrap" />
          <TextBox
            x:Name="AltEscHotkeyTextBox"
            x:Uid="/VirtualMachineSettingsPage/AltEscHotkeyTextBox"
            Grid.Column="1"
            Width="120"
            HorizontalAlignment="Left"
            AutomationProperties.HelpText="[(Optional) Specifies the virtual-key code to add to ALT to determine the hotkey replacement for ALT+ESC.]"
            AutomationProperties.Name="[AltEscHotkey]"
            ToolTipService.ToolTip="[(Optional) Specifies the virtual-key code to add to ALT to determine the hotkey replacement for ALT+ESC.]" />
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock
            x:Uid="/VirtualMachineSettingsPage/AltTabHotkeyLabel"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Text="[AltTabHotkey]"
            TextWrapping="Wrap" />
          <TextBox
            x:Name="AltTabHotkeyTextBox"
            x:Uid="/VirtualMachineSettingsPage/AltTabHotkeyTextBox"
            Grid.Column="1"
            Width="120"
            HorizontalAlignment="Left"
            AutomationProperties.HelpText="[(Optional) Specifies the virtual-key code to add to ALT to determine the hotkey replacement for ALT+TAB.]"
            AutomationProperties.Name="[AltTabHotkey]"
            ToolTipService.ToolTip="[(Optional) Specifies the virtual-key code to add to ALT to determine the hotkey replacement for ALT+TAB.]" />
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock
            x:Uid="/VirtualMachineSettingsPage/AltShiftTabHotkeyLabel"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Text="[AltShiftTabHotkey]"
            TextWrapping="Wrap" />
          <TextBox
            x:Name="AltShiftTabHotkeyTextBox"
            x:Uid="/VirtualMachineSettingsPage/AltShiftTabHotkeyTextBox"
            Grid.Column="1"
            Width="120"
            HorizontalAlignment="Left"
            AutomationProperties.HelpText="[(Optional) Specifies the virtual-key code to add to ALT to determine the hotkey replacement for ALT+SHIFT+TAB.]"
            AutomationProperties.Name="[AltShiftTabHotkey]"
            ToolTipService.ToolTip="[(Optional) Specifies the virtual-key code to add to ALT to determine the hotkey replacement for ALT+SHIFT+TAB.]" />
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock
            x:Uid="/VirtualMachineSettingsPage/AltSpaceHotkeyLabel"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Text="[AltSpaceHotkey]"
            TextWrapping="Wrap" />
          <TextBox
            x:Name="AltSpaceHotkeyTextBox"
            x:Uid="/VirtualMachineSettingsPage/AltSpaceHotkeyTextBox"
            Grid.Column="1"
            Width="120"
            HorizontalAlignment="Left"
            AutomationProperties.HelpText="[(Optional) Specifies the virtual-key code to add to ALT to determine the hotkey replacement for ALT+SPACE.]"
            AutomationProperties.Name="[AltSpaceHotkey]"
            ToolTipService.ToolTip="[(Optional) Specifies the virtual-key code to add to ALT to determine the hotkey replacement for ALT+SPACE.]" />
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock
            x:Uid="/VirtualMachineSettingsPage/CtrlAltDelHotkeyLabel"
            Margin="0,0,12,0"
            VerticalAlignment="Center"
            Text="[CtrlAltDelHotkey]"
            TextWrapping="Wrap" />
          <TextBox
            x:Name="CtrlAltDelHotkeyTextBox"
            x:Uid="/VirtualMachineSettingsPage/CtrlAltDelHotkeyTextBox"
            Grid.Column="1"
